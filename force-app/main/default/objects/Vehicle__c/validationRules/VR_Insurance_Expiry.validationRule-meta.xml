<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Insurance_Expiry</fullName>
    <active>true</active>
    <description>Ensures that the Insurance Expiry Date is not earlier than today&apos;s date.</description>
    <errorConditionFormula>AND(
NOT(ISBLANK(Insurance_Expiry_Date__c)),
Insurance_Expiry_Date__c &lt; TODAY()
)</errorConditionFormula>
    <errorDisplayField>Insurance_Expiry_Date__c</errorDisplayField>
    <errorMessage>Insurance Expiry Date cannot be in the past.</errorMessage>
</ValidationRule>
