<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Driver_Experience</fullName>
    <active>true</active>
    <description>Ensures that Driver Experience is not negative.</description>
    <errorConditionFormula>Driver_Experience_Years__c &lt; 0</errorConditionFormula>
    <errorDisplayField>Driver_Experience_Years__c</errorDisplayField>
    <errorMessage>Driver Experience cannot be negative.</errorMessage>
</ValidationRule>
