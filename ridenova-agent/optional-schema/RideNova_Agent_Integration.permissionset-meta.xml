<?xml version="1.0" encoding="UTF-8"?>
<!--
  OPTIONAL, UNTESTED (written from the project's metadata, never deployed to a live org by the author).
  Review before deploying. Purpose: least-privilege access for the integration user the agent runs as.
  - No delete anywhere. No access to Payment, Driver Assignment, Feedback, Inspection or Maintenance objects.
  - Booking edit is needed because cancelling = setting Booking_Status__c. Salesforce cannot narrow edit to one field
    (required fields are always editable), so the restriction "only status changes" is enforced by the app, not by the org.
  - Fields marked required in the metadata cannot carry field-level permissions, so none are listed for them.
-->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>RideNova Agent Integration</label>
    <description>Least-privilege access for the RideNova AI agent backend.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions><allowCreate>false</allowCreate><allowDelete>false</allowDelete><allowEdit>false</allowEdit><allowRead>true</allowRead><modifyAllRecords>false</modifyAllRecords><object>Contact</object><viewAllRecords>false</viewAllRecords></objectPermissions>
    <objectPermissions><allowCreate>false</allowCreate><allowDelete>false</allowDelete><allowEdit>false</allowEdit><allowRead>true</allowRead><modifyAllRecords>false</modifyAllRecords><object>Vehicle__c</object><viewAllRecords>true</viewAllRecords></objectPermissions>
