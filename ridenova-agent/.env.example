# ---- Copy this file to ".env" and fill in. NEVER commit ".env" (it is git-ignored). ----

# "salesforce" = live org, "demo" = built-in sample data (clearly labelled in the UI).
# Leave empty to auto-pick: salesforce if credentials below are present, otherwise demo.
MODE=

# --- AI model (required for the chat agent). Use EITHER Gemini (has a free tier) OR Anthropic (paid). ---
# LLM_PROVIDER=gemini | anthropic   (leave empty: Gemini is used if only GEMINI_API_KEY is set)
LLM_PROVIDER=

# Option 1 - Google Gemini (free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Option 2 - Anthropic Claude (paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Salesforce, option A: short-lived token from the Salesforce CLI (easiest for local dev) ---
#   sf org display --target-org ActualRideNova --verbose --json   -> copy accessToken + instanceUrl
SF_INSTANCE_URL=
SF_ACCESS_TOKEN=

# --- Salesforce, option B: Connected App with Client Credentials flow (recommended for a real deployment) ---
SF_LOGIN_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# --- Admin view protection. If empty, a random token is printed in the server console at startup. ---
ADMIN_TOKEN=

# --- Optional ---
PORT=3000
APP_TIMEZONE=Asia/Kolkata
# Only set after deploying optional-schema/Issue_Description__c (see README). Lets tickets store the customer's description.
TICKET_DESCRIPTION_FIELD=
